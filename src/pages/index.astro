---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { commerce } from '../lib/commerce';
import { HOME as T } from '../constants/pages';

const collections = await commerce.listCollections();
const byHandle = Object.fromEntries(collections.map((c) => [c.handle, c]));

// three shelves, each with its collection's products
const shelves = await Promise.all(
  T.shelves.map(async (s) => ({
    ...s,
    products: await commerce.listProducts({ collection: s.collection }),
  })),
);

// staggered 2-1-2-1 order for the six category tiles
const tileOrder = ['coffee', 'creamers', 'merch', 'gear', 'capsules', 'gifts'];
const tiles = tileOrder.map((h) => byHandle[h]).filter(Boolean);
const isCentered = (i: number) => i === 2 || i === 5; // rows: 2, 1, 2, 1

const serviceIcons: Record<string, string> = {
  truck: 'M1 5h14v12H1z M15 9h4l3 3v5h-7z M6 19a1.6 1.6 0 1 0 0-.01 M18 19a1.6 1.6 0 1 0 0-.01',
  mail: 'M2 5h20v14H2z M2 6l10 7L22 6',
  shield: 'M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5z',
  chat: 'M21 12a8 8 0 0 1-8 8H4l1.5-3A8 8 0 1 1 21 12z',
};
---

<Layout overlayHeader={true}>
  <!-- Hero: centered heading over a full-bleed image; category tiles overlap below -->
  <section class="relative">
    <img src={T.hero.image.src} alt={T.hero.image.alt} class="h-[68vh] min-h-[460px] w-full object-cover" />
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="absolute inset-0 flex items-center justify-center px-5 pb-24">
      <div class="max-w-3xl text-center text-white">
        <h1 class="font-display text-[clamp(38px,6vw,72px)] font-black uppercase leading-[1.02] tracking-tight">
          {T.hero.title}
        </h1>
        <p class="mx-auto mt-5 max-w-[54ch] text-[16px] leading-relaxed text-white/85">{T.hero.text}</p>
      </div>
    </div>
  </section>

  <!-- Category tiles ×6: staggered 2-1-2-1, pulled up over the hero -->
  <section class="relative z-10 mx-auto -mt-24 max-w-6xl px-5">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      {tiles.map((c, i) => (
        <a
          href={`/collections/${c.handle}`}
          class:list={[
            'group relative block overflow-hidden rounded-xl',
            isCentered(i) && 'sm:col-span-2 sm:mx-auto sm:w-[calc(50%-10px)]',
          ]}
        >
          <img
            src={T.categoryShelf.images[c.handle]}
            alt={c.title}
            class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-[1.04]"
            loading={i < 2 ? 'eager' : 'lazy'}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-black/10"></div>
          <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 p-5 text-white">
            <div>
              <h3 class="font-display text-[19px] font-extrabold uppercase tracking-wide">{c.title}</h3>
              <p class="mt-1 max-w-[40ch] text-[13px] text-white/75">{c.description}</p>
            </div>
            <span class="mb-1 shrink-0 text-[18px] text-white/70 transition group-hover:translate-x-1 group-hover:text-brand">›</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Product shelves: one slider per featured collection -->
  {shelves.map((shelf) => (
    <section class="mx-auto max-w-6xl px-5 pt-14">
      <h2 class="font-display text-[26px] font-extrabold uppercase tracking-wide">{shelf.title}</h2>
      <div class="relative mt-6" data-shelf>
        <div class="flex snap-x snap-mandatory gap-5 overflow-x-auto pb-2 [-webkit-overflow-scrolling:touch] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-shelf-track>
          {shelf.products.map((p) => (
            <div class="w-[260px] shrink-0 snap-start sm:w-[300px]">
              <ProductCard product={p} category={byHandle[shelf.collection]?.title} />
            </div>
          ))}
        </div>
        <button data-shelf-prev class="absolute -left-3 top-1/2 hidden -translate-y-1/2 rounded-full border border-line bg-paper p-2.5 text-ink shadow-lg transition hover:border-brand hover:text-brand md:block" aria-label="Scroll back">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button data-shelf-next class="absolute -right-3 top-1/2 hidden -translate-y-1/2 rounded-full border border-line bg-paper p-2.5 text-ink shadow-lg transition hover:border-brand hover:text-brand md:block" aria-label="Scroll forward">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
      <div class="mt-6 text-center">
        <a href={`/collections/${shelf.collection}`} class="inline-block rounded-md border border-line px-7 py-3 text-[14px] font-semibold transition hover:border-brand hover:text-brand">
          {shelf.allLabel}
        </a>
      </div>
    </section>
  ))}

  <!-- Services: fixed white band, icon larger than the title, vertical separators -->
  <section class="mt-16 bg-white text-[#120d0a]">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-y-8 px-5 py-10 sm:grid-cols-2 sm:py-12 lg:grid-cols-4 lg:divide-x lg:divide-[#e5ddd0]">
      {T.services.map((s) => (
        <div class="lg:px-7 lg:first:pl-0 lg:last:pr-0">
          <div class="flex items-center gap-3">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-brand">
              {serviceIcons[s.icon].split(' M').map((d, i) => <path d={i === 0 ? d : 'M' + d} />)}
            </svg>
            <h3 class="text-[15px] font-extrabold uppercase tracking-wide">{s.title}</h3>
          </div>
          <p class="mt-3 text-[14px] leading-relaxed text-[#5c534a]">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Editorial banner: background photo, white text LEFT, outline CTA — the theme colophon -->
  <section class="relative mt-16 overflow-hidden">
    <img src={T.colophon.image.src} alt={T.colophon.image.alt} class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative mx-auto max-w-6xl px-5 py-20 md:py-28">
      <div class="max-w-xl text-white">
        <p class="text-[13px] font-medium text-white/70">{T.colophon.eyebrow}</p>
        <h2 class="mt-3 font-display text-[clamp(26px,3.5vw,40px)] font-black uppercase leading-tight tracking-tight">
          {T.colophon.title}
        </h2>
        <p class="mt-4 text-[15px] leading-relaxed text-white/85">{T.colophon.text}</p>
        <a href={T.colophon.cta.href} class="mt-7 inline-block rounded-md border-2 border-white px-7 py-3 text-[14px] font-bold uppercase tracking-wide text-white transition hover:bg-white hover:text-[#120d0a]">
          {T.colophon.cta.label}
        </a>
      </div>
    </div>
  </section>

  <script>
    // shelf sliders: arrows scroll by one card width
    document.querySelectorAll<HTMLElement>('[data-shelf]').forEach((shelf) => {
      const track = shelf.querySelector<HTMLElement>('[data-shelf-track]')!;
      const step = () => (track.firstElementChild as HTMLElement)?.offsetWidth + 20 || 320;
      shelf.querySelector('[data-shelf-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      shelf.querySelector('[data-shelf-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    });
  </script>
</Layout>
