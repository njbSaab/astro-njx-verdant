---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { commerce } from '../lib/commerce';
import { HOME as T } from '../constants/pages';

const [products, collections] = await Promise.all([
  commerce.listProducts({ limit: 8 }),
  commerce.listCollections(),
]);
const shelfImages: Record<string, string> = {
  dresses: '/products/silk-slip-dress.jpg',
  knitwear: '/products/ribbed-cardigan.jpg',
  outerwear: '/products/wool-wrap-coat.jpg',
  accessories: '/products/canvas-tote.jpg',
};
---

<Layout>
  <!-- Hero: full-bleed editorial slider (vanilla JS, no libraries) -->
  <section class="relative h-[62vh] min-h-[420px] overflow-hidden md:h-[74vh]" data-hero-slider>
    {T.heroSlides.map((s, i) => (
      <div
        data-hero-slide
        class:list={[
          'absolute inset-0 transition-opacity duration-700',
          i === 0 ? 'opacity-100' : 'pointer-events-none opacity-0',
        ]}
      >
        <img src={s.image.src} alt={s.image.alt} class="h-full w-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/65 via-ink/25 to-ink/5"></div>
        <div class="absolute inset-x-0 bottom-0">
          <div class="mx-auto max-w-6xl px-5 pb-14 md:pb-16">
            {i === 0
              ? <h1 class="max-w-[16ch] font-display text-[clamp(40px,6.5vw,80px)] font-medium leading-[1.02] text-white">{s.title}</h1>
              : <p class="max-w-[16ch] font-display text-[clamp(40px,6.5vw,80px)] font-medium leading-[1.02] text-white">{s.title}</p>}
            <p class="mt-4 max-w-[46ch] text-[16px] leading-relaxed text-white/85">{s.text}</p>
            <div class="mt-7 flex flex-wrap items-center gap-3">
              <a href={s.ctaPrimary.href} class="bg-paper px-7 py-3.5 text-[14px] font-semibold text-ink hover:bg-white">
                {s.ctaPrimary.label}
              </a>
              <a href={s.ctaSecondary.href} class="border border-white/60 px-7 py-3.5 text-[14px] font-semibold text-white hover:bg-white/10">
                {s.ctaSecondary.label}
              </a>
              <span class="ml-1 hidden text-[13px] text-white/70 sm:inline">{s.note}</span>
            </div>
          </div>
        </div>
      </div>
    ))}
    <div class="absolute bottom-5 right-5 z-10 flex items-center gap-2 md:bottom-7 md:right-8">
      {T.heroSlides.map((_, i) => (
        <button
          type="button"
          data-hero-dot={i}
          aria-label={`Show slide ${i + 1}`}
          aria-pressed={i === 0}
          class="h-[3px] w-7 bg-white/40 transition aria-pressed:bg-white"
        ></button>
      ))}
    </div>
  </section>

  <!-- Collections shelf -->
  <section class="mx-auto max-w-6xl px-5 py-10 sm:py-16">
    <h2 class="font-display text-3xl font-medium tracking-tight">{T.collections.title}</h2>
    <div class="mt-7 grid grid-cols-2 gap-5 lg:grid-cols-4">
      {collections.filter((c) => shelfImages[c.handle]).map((c) => (
        <a href={`/collections/${c.handle}`} class="group block">
          <div class="overflow-hidden rounded-lg bg-tile">
            <img
              src={shelfImages[c.handle]}
              alt={c.title}
              class="aspect-[3/4] w-full object-cover transition duration-300 group-hover:scale-[1.02]"
              loading="lazy"
            />
          </div>
          <h3 class="mt-3 font-display text-[18px] group-hover:underline group-hover:underline-offset-4">{c.title}</h3>
          <p class="mt-1 text-[14px] text-muted">{c.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Products -->
  <section class="mx-auto max-w-6xl px-5 py-4 sm:py-14">
    <div class="flex items-baseline justify-between">
      <h2 class="font-display text-3xl font-bold tracking-tight">{T.products.title}</h2>
      <p class="text-[14px] text-muted">{products.length} {T.products.countLabel}</p>
    </div>
    <div class="mt-7 grid grid-cols-2 gap-x-5 gap-y-5 md:grid-cols-4">
      {products.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <!-- Atelier principles: editorial hairline columns, no cards or icons -->
  <section class="mx-auto max-w-6xl px-5 py-8 sm:py-12">
    <div class="grid gap-8 border-t border-ink pt-8 sm:grid-cols-3 sm:gap-10">
      {T.values.map((v, i) => (
        <div>
          <p class="font-display text-[15px] italic text-brand">No. {i + 1}</p>
          <h3 class="mt-2 font-display text-[20px]">{v.title}</h3>
          <p class="mt-2 max-w-[38ch] text-[14px] leading-relaxed text-muted">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Lookbook strip: full-bleed image band -->
  <section class="py-4 sm:py-8">
    <div class="mx-auto max-w-6xl px-5 pb-6">
      <h2 class="font-display text-3xl font-medium tracking-tight">{T.lookbook.title}</h2>
      <p class="mt-2 text-[15px] text-muted">{T.lookbook.text}</p>
    </div>
    <div class="grid grid-cols-2 gap-1 md:grid-cols-4">
      {T.lookbook.images.map((im) => (
        <img src={im.src} alt={im.alt} class="aspect-[3/4] w-full object-cover" loading="lazy" />
      ))}
    </div>
  </section>

  <!-- Quote -->
  <section class="mx-auto max-w-3xl px-5 py-10 text-center sm:py-16">
    <blockquote class="font-display text-[clamp(22px,3vw,30px)] font-semibold leading-snug">
      {T.quote.text}
    </blockquote>
    <p class="mt-4 text-[14px] text-muted">{T.quote.author}</p>
  </section>

  <!-- Theme colophon: this store is the product -->
  <section class="mx-auto max-w-6xl px-5 pb-4 sm:pb-8">
    <div class="grid gap-5 rounded-2xl border border-brand-deep bg-brand p-4 text-white sm:gap-10 sm:p-10 md:grid-cols-[1.2fr_1fr] md:items-center">
      <div>
        <p class="text-[13px] font-medium text-white/70">{T.colophon.eyebrow}</p>
        <h2 class="mt-3 font-display text-[clamp(26px,3.5vw,38px)] font-bold leading-tight tracking-tight">
          {T.colophon.title}
        </h2>
        <p class="mt-4 max-w-[52ch] text-[15px] leading-relaxed text-white/85">{T.colophon.text}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={T.colophon.ctaPrimary.href} class="rounded-md bg-white px-6 py-3.5 text-[15px] font-semibold text-brand hover:bg-white/90">
            {T.colophon.ctaPrimary.label}
          </a>
          <a href={T.colophon.ctaSecondary.href} class="rounded-md border border-white/40 px-6 py-3.5 text-[15px] font-semibold text-white hover:bg-white/10">
            {T.colophon.ctaSecondary.label}
          </a>
        </div>
      </div>
      <ul class="grid min-w-0 gap-3 rounded-xl bg-brand-deep/60 p-4 text-[14px] leading-relaxed sm:p-7">
        {T.colophon.stack.map((s, i) => (
          <li class="flex gap-3">
            <span class="mt-0.5 text-white/60">{String(i + 1).padStart(2, '0')}</span>
            <span><strong class="font-semibold">{s.strong}</strong> {s.text}</span>
          </li>
        ))}
        <li>
          <button
            type="button"
            data-copy-env={T.colophon.env.copyValue}
            class="group/copy mt-2 flex w-full items-center justify-between gap-3 rounded-md bg-black/25 px-4 py-2.5 text-left font-mono text-[13px] text-white/90 transition hover:bg-black/35"
            aria-label={`Copy ${T.colophon.env.copyValue} to clipboard`}
          >
            <span>{T.colophon.env.prefix}<span class="text-white">{T.colophon.env.value}</span></span>
            <span data-copy-icon class="text-white/60 transition group-hover/copy:text-white">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" />
              </svg>
            </span>
            <span data-copy-done class="hidden text-[12px] font-sans font-semibold text-white">{T.colophon.env.copiedLabel}</span>
          </button>
        </li>
      </ul>
    </div>
  </section>

  <script>
    // ── Hero slider: fade between slides, auto-advance, pause on hover ──
    const slider = document.querySelector<HTMLElement>('[data-hero-slider]');
    if (slider) {
      const slides = [...slider.querySelectorAll<HTMLElement>('[data-hero-slide]')];
      const dots = [...slider.querySelectorAll<HTMLElement>('[data-hero-dot]')];
      let current = 0;
      let timer: ReturnType<typeof setInterval>;

      function show(i: number) {
        current = (i + slides.length) % slides.length;
        slides.forEach((s, n) => {
          s.classList.toggle('opacity-100', n === current);
          s.classList.toggle('opacity-0', n !== current);
          s.classList.toggle('pointer-events-none', n !== current);
        });
        dots.forEach((d, n) => d.setAttribute('aria-pressed', String(n === current)));
      }
      function play() {
        timer = setInterval(() => show(current + 1), 5000);
      }
      dots.forEach((d, n) =>
        d.addEventListener('click', () => {
          clearInterval(timer);
          show(n);
          play();
        }),
      );
      slider.addEventListener('mouseenter', () => clearInterval(timer));
      slider.addEventListener('mouseleave', play);
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) play();
    }

    document.querySelectorAll<HTMLButtonElement>('[data-copy-env]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(btn.dataset.copyEnv!);
        const icon = btn.querySelector('[data-copy-icon]')!;
        const done = btn.querySelector('[data-copy-done]')!;
        icon.classList.add('hidden');
        done.classList.remove('hidden');
        setTimeout(() => {
          done.classList.add('hidden');
          icon.classList.remove('hidden');
        }, 1600);
      });
    });
  </script>
</Layout>
